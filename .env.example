# ── Secrets : NE JAMAIS COMMITER CE FICHIER ────────────────────────────────
# .env.local est dans .gitignore. Copie ce fichier en .env.local et remplis.
# cp .env.example .env.local

# ─────────────────── Discord (porte d'entrée du site) ───────────────────
# https://discord.com/developers/applications → New Application
# Onglet "OAuth2" :
#   - Client ID      → DISCORD_CLIENT_ID
#   - Client Secret  → DISCORD_CLIENT_SECRET  (bouton Reset Secret)
#   - Redirects      → ajouter EXACTEMENT l'URL de callback ci-dessous
#
# Callback à déclarer :
#   local  : http://localhost:3000/api/auth/discord-callback
#   Vercel : https://ton-domaine.vercel.app/api/auth/discord-callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Identifiant(s) Discord de l'administrateur. Plusieurs possibles, séparés
# par des virgules. C'est le SEUL moyen d'entrer dans la page admin.
# Pour le trouver : Discord → Paramètres → Avancés → Mode développeur, puis
# clic droit sur ton pseudo → Copier l'identifiant.
DISCORD_ADMIN_ID=

# Facultatif : si absent, dérivé de BASE_URL.
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord-callback

# ─────────────────── Steam (liaison de la ludothèque) ───────────────────
# https://steamcommunity.com/dev/apikey
# ATTENTION : ne jamais coller cette valeur dans le chat, dans un ticket,
# ni dans un message. Elle donne accès aux ludothèques et temps de jeu.
STEAM_API_KEY=

# ─────────────────── Base de données ───────────────────
# URL Postgres (Neon). En local : postgres://... ou le pooled connection string.
# Sur Vercel : fourni automatiquement par l'intégration Neon.
DATABASE_URL=

# ─────────────────── Session ───────────────────
# Secret de session — génère avec : openssl rand -hex 32
SESSION_SECRET=

# ─────────────────── URL publique ───────────────────
# URL publique du site, SANS slash final.
# Local  : http://localhost:3000
# Vercel : https://steam-match.vercel.app
# Doit correspondre EXACTEMENT au domaine déclaré lors de la création de la
# clé API Steam et de l'application Discord.
BASE_URL=http://localhost:3000
