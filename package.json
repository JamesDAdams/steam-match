{
  "name": "le-bastion-des-gamers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/dev-server.mjs",
    "dev:api": "vercel dev --listen 3000",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true",
    "dev:vercel": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "check:vues": "node scripts/render-check.mjs",
    "db:schema": "node scripts/apply-schema.mjs",
    "db:inspect": "node scripts/inspect-db.mjs",
    "test:netlify": "node scripts/test-netlify.mjs",
    "test:discord": "node scripts/test-discord-events.mjs",
    "test:enrich": "node scripts/test-enrich.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.36.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.2",
    "@types/node": "^26.6.6",
    "@vercel/node": "^32.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.28.1",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}